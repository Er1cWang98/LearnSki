.mine-page { padding-bottom: 80rpx; }
.mine-header { display: flex; flex-direction: column; gap: 16rpx; padding: 48rpx 36rpx 42rpx; background: #e9f0f0; }
.mine-title { font-size: 50rpx; font-weight: 700; }
.mine-summary { display: flex; margin: 36rpx 32rpx 0; padding: 28rpx 0; border-top: 1rpx solid #d9e2e5; border-bottom: 1rpx solid #d9e2e5; }
.summary-item { display: flex; flex-direction: column; gap: 8rpx; width: 50%; }
.summary-item + .summary-item { padding-left: 28rpx; border-left: 1rpx solid #d9e2e5; }
.summary-value { font-size: 42rpx; font-weight: 700; }
.summary-label { color: #657783; font-size: 25rpx; }
.mine-notice { margin: 24rpx 32rpx 0; }
.records-section { margin: 46rpx 32rpx 0; }
.records-empty { display: flex; flex-direction: column; align-items: center; padding: 90rpx 0 30rpx; }
.records-icon { color: #9fb2b9; font-size: 68rpx; }
.records-message { margin-top: 12rpx; color: #657783; font-size: 27rpx; }
.learn-button { min-height: 44px; margin-top: 28rpx; padding: 0 32rpx; background: transparent; color: #0b807f; font-size: 27rpx; font-weight: 600; }
