.mine-page { padding-bottom: calc(80rpx + env(safe-area-inset-bottom)); }
.mine-header { display: flex; flex-direction: column; gap: 16rpx; padding: 48rpx 36rpx 42rpx; background: #e9f0f0; }
.mine-title { font-size: 50rpx; font-weight: 700; }
.mine-summary { display: flex; margin: 36rpx 32rpx 0; padding: 28rpx 0; border-top: 1rpx solid #d9e2e5; border-bottom: 1rpx solid #d9e2e5; }
.summary-item { display: flex; flex-direction: column; gap: 8rpx; width: 50%; }
.summary-item + .summary-item { padding-left: 28rpx; border-left: 1rpx solid #d9e2e5; }
.summary-value { font-size: 42rpx; font-weight: 700; }
.summary-label { color: #657783; font-size: 25rpx; }
.mine-notice { margin: 24rpx 32rpx 0; }
.records-section { margin: 46rpx 32rpx 0; }
.records-heading { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.filter-control { display: flex; align-items: center; justify-content: flex-end; min-height: 44px; max-width: 370rpx; color: #0b807f; font-size: 26rpx; text-align: right; }
.filter-control text { padding-left: 8rpx; font-size: 33rpx; }
.records-empty { display: flex; flex-direction: column; align-items: center; padding: 72rpx 0 30rpx; }
.records-message { display: block; padding: 40rpx 0; color: #657783; font-size: 27rpx; text-align: center; }
.learn-button, .more-button { display: flex; align-items: center; justify-content: center; min-height: 44px; margin-top: 16rpx; padding: 0 32rpx; background: transparent; color: #0b807f; font-size: 27rpx; font-weight: 600; }
.record-list { margin-top: 20rpx; border-top: 1rpx solid #d9e2e5; }
.record-row { display: flex; align-items: center; width: 100%; min-height: 116rpx; padding: 18rpx 0; margin: 0; background: transparent; border-bottom: 1rpx solid #d9e2e5; border-radius: 0; color: #173044; text-align: left; line-height: normal; }
.record-main { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 8rpx; }
.video-placeholder { display: flex; flex-direction: column; align-items: center; justify-content: center; flex-shrink: 0; width: 112rpx; height: 88rpx; margin-right: 20rpx; border-radius: 8rpx; background: #e9f0f0; color: #657783; font-size: 20rpx; gap: 6rpx; }
.record-title { font-size: 29rpx; font-weight: 600; white-space: normal; }
.record-meta { color: #657783; font-size: 24rpx; }
.record-arrow { padding-left: 16rpx; color: #82949d; font-size: 38rpx; }
