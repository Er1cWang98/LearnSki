.learn-page { padding-bottom: 72rpx; }
.intro-band { padding: 46rpx 36rpx 42rpx; background: #e9f0f0; }
.hero-line { display: flex; align-items: baseline; justify-content: space-between; margin-top: 18rpx; }
.hero-title { font-size: 54rpx; font-weight: 700; line-height: 1.3; }
.hero-mark { font-size: 27rpx; color: #657783; }
.hero-copy { display: block; margin: 12rpx 0 40rpx; color: #506876; font-size: 27rpx; line-height: 1.6; }
.progress-line { display: flex; justify-content: space-between; align-items: baseline; padding: 22rpx 0; border-top: 1rpx solid #d0dfe0; font-size: 27rpx; }
.progress-count { font-size: 40rpx; font-weight: 700; color: #173044; }
.intro-band .status-note { margin: 8rpx 0 20rpx; }
.stage-complete { margin: 8rpx 0 18rpx; color: #0b807f; font-size: 27rpx; font-weight: 600; }
.primary-action { display: flex; align-items: center; justify-content: center; min-height: 44px; margin-top: 22rpx; background: #0b807f; color: white; font-size: 30rpx; font-weight: 600; border-radius: 8rpx; }
.primary-action text { margin-left: 12rpx; font-size: 42rpx; line-height: 1; }
.route-section { padding: 40rpx 32rpx 0; }
.section-heading { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 20rpx; }
.course-count { font-size: 24rpx; color: #657783; }
.route-list { border-top: 1rpx solid #d9e2e5; }
.course-row { display: flex; width: 100%; min-height: 148rpx; padding: 26rpx 2rpx; margin: 0; background: transparent; border-bottom: 1rpx solid #d9e2e5; border-radius: 0; text-align: left; color: #173044; line-height: normal; }
.course-number { flex: 0 0 58rpx; padding-top: 4rpx; color: #0b807f; font-size: 28rpx; font-weight: 700; }
.course-main { flex: 1; min-width: 0; }
.course-top { display: flex; justify-content: space-between; align-items: baseline; gap: 12rpx; }
.course-title { flex: 1; font-size: 30rpx; font-weight: 650; white-space: normal; line-height: 1.4; }
.course-type { flex: 0 0 auto; color: #657783; font-size: 22rpx; }
.course-goal { display: -webkit-box; overflow: hidden; -webkit-line-clamp: 2; -webkit-box-orient: vertical; margin: 9rpx 0 12rpx; color: #657783; font-size: 24rpx; line-height: 1.5; white-space: normal; }
.course-bottom { display: flex; align-items: center; justify-content: space-between; }
.state { font-size: 24rpx; font-weight: 600; }
.state-completed, .state-available { color: #0b807f; }
.state-locked, .state-unknown { color: #657783; }
.course-chevron { font-size: 40rpx; color: #82949d; line-height: 1; }
.next-stage { display: flex; flex-direction: column; gap: 8rpx; margin: 48rpx 32rpx 0; padding: 28rpx 4rpx; border-top: 1rpx solid #d9e2e5; }
.next-title { color: #657783; font-size: 31rpx; }
